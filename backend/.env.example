APP_ENV=development
DATABASE_URL=sqlite:///./brandguard.db
FRONTEND_ORIGIN=http://localhost:3000
AUTH_SECRET=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# JSON user records. In production, use password_hash values instead of password.
# AUTH_USERS_JSON={"creator":{"username":"creator@brandguard.local","password":"creator-demo","role":"creator"},"manager":{"username":"manager@brandguard.local","password":"manager-demo","role":"manager"},"legal":{"username":"legal@brandguard.local","password":"legal-demo","role":"legal"}}
# Set this in production when connecting to PostgreSQL:
# DATABASE_URL=postgresql+psycopg://brandguard:change-me@db:5432/brandguard
